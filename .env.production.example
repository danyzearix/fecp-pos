# FECP POS — variables de PRODUCCIÓN (Docker). Copia a ".env.production" en el servidor y llénalo ahí.
# NUNCA subas .env.production a git ni lo pegues en chats. Aquí solo van valores de ejemplo.
# Los modos de prueba quedan ENCENDIDOS por defecto: cambiarlos es una decisión consciente (ver DEPLOY.md).

# --- Docker / Traefik (los usa docker-compose.yml) ---
POS_DOMAIN=pos.fecp.me
# Nombres tal como están definidos en el Traefik del servidor
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Base de datos (contenedor "db", propio de este sistema) ---
POSTGRES_USER=fecp
# Genera una así (solo hexadecimal): openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=fecp_pos
# DATABASE_URL NO se escribe aquí: compose la arma como postgresql://USER:CLAVE@db:5432/DB

# --- Respaldos (los usa deploy/backup.sh desde el cron del servidor; la app no los necesita) ---
# Carpeta de respaldos en el servidor (fuera de la carpeta del proyecto)
BACKUP_DIR=/docker/fecp-pos/backups
# Días que se conservan los respaldos locales
BACKUP_RETENTION_DAYS=14
# Destino FUERA del servidor, con el formato de rclone "NOMBRE_DEL_REMOTO:ruta". Debe ser el remoto CIFRADO
# (tipo crypt sobre Backblaze B2), p. ej.  fecp-b2-cifrado:pos   (ver DEPLOY.md, sección Respaldos).
# Vacío = el respaldo solo queda en este servidor (el script lo avisa en cada corrida).
BACKUP_RCLONE_REMOTE=
# Días que se conservan en el destino externo. Vacío = NO se borra nada allá.
# Como los respaldos incluyen los comprobantes, NO debe superar RECEIPT_RETENTION_DAYS (180): si no, una foto
# "eliminada por retención" seguiría existiendo en Backblaze.
BACKUP_REMOTE_RETENTION_DAYS=180

# --- Sesión ---
# openssl rand -hex 48     (nueva, distinta a la de desarrollo)
SESSION_SECRET=
# Se sirve por HTTPS (Traefik) -> true
COOKIE_SECURE=true

# --- Dirección pública (activa el webhook de ePayco y el QR de pago) ---
APP_PUBLIC_URL=https://pos.fecp.me

# --- WooCommerce ---
WOO_URL=https://tu-tienda.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# --- Siigo ---
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
SIIGO_DOCUMENT_ID=
SIIGO_SELLER_ID=
# true = NO va a la DIAN. Déjalo en true hasta el paso a real (sección 13 del README).
SIIGO_TEST_MODE=true
SIIGO_TEST_DOCUMENT_ID=6503
# Forma de pago de Siigo para el CRÉDITO FECP (debe ser una de GET /v1/payment-types con due_date=true; "Crédito" suele ser 1667).
# Vacía + SIIGO_TEST_MODE=false = el sistema se NIEGA a facturar ventas a crédito (se ve en Admin → Configuración).
SIIGO_PAYMENT_CREDITO_ID=

# --- Fiscal / punto de venta ---
UVT_VALUE=52374
# Consumidor final (222222222222) sin importar el monto — Res. DIAN 165/2023, art. 11, num. 3.3: se puede facturar a Consumidor final
# sin tope si el cliente no entrega sus datos. true (por defecto) = sin tope. false = se conserva el tope anterior: por encima de
# 5 UVT (base sin IVA) hay que identificar al cliente. El contador debe confirmar el efecto de la Res. 227/2025; si indica que sí
# aplica un tope, cambia esto a false y reinicia (no hace falta tocar el código).
CONSUMIDOR_FINAL_SIN_TOPE=true
POS_ADDRESS=
POS_STATE_CODE=11
POS_CITY_CODE=11001
NEXT_PUBLIC_CAJA_PREFIX=C01

# --- Datos del negocio (tirilla) ---
# OJO con las tildes: la tirilla imprime este texto TAL CUAL (en mayúsculas). Ej.: FUNDACIÓN EDUCACIÓN CRISTIANA PENTECOSTAL
NEGOCIO_NOMBRE=
NEGOCIO_NIT=
NEGOCIO_DIRECCION=
NEGOCIO_TELEFONO=
SOFTWARE_NOMBRE="FECP POS"
SOFTWARE_FABRICANTE="Atria Digital"

# --- Resolución DIAN (se imprime en la tirilla) ---
RESOLUCION_DIAN_NUMERO=
RESOLUCION_DIAN_FECHA=
RESOLUCION_DIAN_RANGO=
RESOLUCION_DIAN_VIGENCIA=
# RESOLUCION_DIAN_RANGO: se leen los DOS últimos números como "desde" y "hasta" (ej. 1-50000, o "FV-1 1 al 50000"); el prefijo sale del número de factura que devuelve Siigo.
# Textos fijos de la tirilla (opcionales: sin estas variables se usan los valores de ejemplo):
#   TICKET_REGIMEN="Régimen Especial"
#   TICKET_ACTIVIDAD_ECONOMICA=8559
#   TICKET_PROVEEDOR_SOFTWARE="Siigo S.A.S - Nit: 830.048.145-8"
#   TICKET_NOMBRE_SOFTWARE="Siigo Nube"

# Foto del comprobante con Transferencia: false (por defecto) = OPCIONAL; true = OBLIGATORIA (la referencia y la casilla de verificación son obligatorias siempre).
REQUIRE_RECEIPT_PHOTO=false
# Plazo ÚNICO del Crédito FECP en días (gerencia autorizó 60). El servidor rechaza cualquier otro.
CREDITO_PLAZO_DIAS=60

# --- ePayco / Davipay ---
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_P_CUST_ID_CLIENTE=
EPAYCO_P_KEY=
# true = pagos de prueba (no cobran). Déjalo en true hasta el paso a real.
EPAYCO_TEST_MODE=true
# Se completan solos desde APP_PUBLIC_URL; déjalos vacíos salvo que ePayco necesite otra ruta
EPAYCO_CONFIRMATION_URL=
EPAYCO_RESPONSE_URL=
# Consulta ACTIVA: cada cuántos segundos el SERVIDOR le pregunta a ePayco por los cobros que siguen esperando (por si el webhook
# se retrasa). Por defecto 20; mínimo 5; 0 = apagada. Solo consulta intentos cuya referencia larga (ref_payco) ya conoce.
EPAYCO_POLL_SECONDS=20
# Facturar AUTOMÁTICAMENTE con el webhook FIRMADO de ePayco cuando no llegó la referencia larga para consultarlo (p. ej. PSE por QR).
# APAGADA por defecto. Riesgo: no se le pregunta a ePayco; se exige que el aviso coincida en todo con la venta (README §10c).
# Sin esto, esas ventas quedan en Pagos por revisar con el botón "Facturar con evidencia del webhook".
EPAYCO_TRUST_SIGNED_WEBHOOK=false
# EXPERIMENTAL, apagada: probar también consultar a ePayco con x_transaction_id y x_ref_payco (ePayco no documenta que funcione).
EPAYCO_ALT_REF_LOOKUP=false
# Id REAL de la forma de pago de ePayco en Siigo (el 5798 es solo de pruebas). Vacío = solo factura en pruebas.
EPAYCO_SIIGO_PAYMENT_ID=
KIOSCO_IMPRESORA=false

# --- Comprobantes de pago (fotos) ---
# Días que se guardan los archivos, contados desde la fecha de la venta. Luego se borra el archivo y queda el registro
# "Eliminado por retención". BACKUP_REMOTE_RETENTION_DAYS NO debe ser mayor que este valor.
RECEIPT_RETENTION_DAYS=180
# Carpeta de los comprobantes dentro del contenedor (es el volumen fecp_pos_uploads). Normalmente no se cambia.
# RECEIPTS_DIR=/app/uploads/comprobantes

# Validación de precios de la caja: horas hacia atrás en que un precio/IVA/SKU anterior sigue siendo válido
# (para ventas hechas sin conexión antes de un cambio de precio). Cualquier otra diferencia retiene la venta.
PRICE_HISTORY_HOURS=72
