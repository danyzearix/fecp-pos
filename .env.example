# Base de datos
DATABASE_URL=postgresql://postgres:CLAVE@localhost:5432/fecp_pos

# Sesión (cadena larga aleatoria; mínimo 32 caracteres)
SESSION_SECRET=
# true solo si sirves la app por HTTPS (con http://localhost déjalo en false)
COOKIE_SECURE=false

# WooCommerce
WOO_URL=https://tu-tienda.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Siigo
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
SIIGO_DOCUMENT_ID=
SIIGO_SELLER_ID=
# true = crea la factura sin enviarla a la DIAN
SIIGO_TEST_MODE=true

# Fiscal / punto de venta
UVT_VALUE=52374
# Consumidor final (222222222222) sin importar el monto — Res. DIAN 165/2023, art. 11, num. 3.3: se puede facturar a Consumidor final
# sin tope si el cliente no entrega sus datos. true (por defecto) = sin tope. false = se conserva el tope anterior: por encima de
# 5 UVT (base sin IVA) hay que identificar al cliente. El contador debe confirmar el efecto de la Res. 227/2025; si indica que sí
# aplica un tope, cambia esto a false y reinicia (no hace falta tocar el código).
CONSUMIDOR_FINAL_SIN_TOPE=true
POS_ADDRESS=
POS_STATE_CODE=11
POS_CITY_CODE=11001
# Prefijo de la caja para el número local (C01-000123)
NEXT_PUBLIC_CAJA_PREFIX=C01

# Datos del negocio (tirilla)
NEGOCIO_NOMBRE=
NEGOCIO_NIT=
NEGOCIO_DIRECCION=
NEGOCIO_TELEFONO=
SOFTWARE_NOMBRE="FECP POS"
SOFTWARE_FABRICANTE="Atria Digital"

# Modo prueba: documento NO electrónico de Siigo (no va a la DIAN)
SIIGO_TEST_DOCUMENT_ID=6503

# Resolución DIAN de facturación electrónica (se imprime en la tirilla; Siigo no la entrega por API)
RESOLUCION_DIAN_NUMERO=
RESOLUCION_DIAN_FECHA=
RESOLUCION_DIAN_RANGO=
RESOLUCION_DIAN_VIGENCIA=


# --- Autoservicio con pago electrónico (ePayco / Davipay) ---
# Llaves de APIFY (panel de ePayco → Configuración → Personalizaciones → Llaves secretas)
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
# Para validar la firma del webhook (panel de ePayco: Customer ID y P_KEY). NO son las llaves de arriba.
EPAYCO_P_CUST_ID_CLIENTE=
EPAYCO_P_KEY=
# true = transacciones de prueba (tarjetas de prueba). En producción: false.
EPAYCO_TEST_MODE=true
# Dominio público con HTTPS del POS (en el deploy). Al definirlo se activan el webhook de ePayco y el QR de pago en la caja.
# VACÍO = modo local: pago onpage en la pantalla, sin webhook ni QR. (Las páginas /pagar/<código> están siempre activas.)
APP_PUBLIC_URL=
# Solo si APP_PUBLIC_URL está definido (por defecto salen de APP_PUBLIC_URL)
EPAYCO_CONFIRMATION_URL=
EPAYCO_RESPONSE_URL=
# Consulta ACTIVA: cada cuántos segundos el SERVIDOR le pregunta a ePayco por los cobros que siguen esperando (por si el webhook
# se retrasa). Por defecto 20; mínimo 5; 0 = apagada. Solo consulta intentos cuya referencia larga (ref_payco) ya conoce.
EPAYCO_POLL_SECONDS=20
# Facturar AUTOMÁTICAMENTE con el webhook FIRMADO de ePayco cuando no llegó la referencia larga para consultarlo (p. ej. PSE por QR).
# APAGADA por defecto. Riesgo: no se le pregunta a ePayco; se exige que el aviso coincida en todo con la venta (README §10c).
# Sin esto, esas ventas quedan en Pagos por revisar con el botón "Facturar con evidencia del webhook".
EPAYCO_TRUST_SIGNED_WEBHOOK=false
# EXPERIMENTAL, apagada: probar también consultar a ePayco con x_transaction_id y x_ref_payco (ePayco no documenta que funcione).
EPAYCO_ALT_REF_LOOKUP=false
# Forma de pago de Siigo para el pago electrónico. Si falta, SOLO se factura en modo de pruebas (usa 5798).
EPAYCO_SIIGO_PAYMENT_ID=
# true = el kiosco imprime la tirilla al aprobarse el pago; false = pantalla final + factura por correo
KIOSCO_IMPRESORA=false

# Comprobantes de pago: días que se guardan los archivos (desde la fecha de la venta)
RECEIPT_RETENTION_DAYS=180

# Forma de pago de Siigo para el CRÉDITO FECP (de GET /v1/payment-types con due_date=true). Vacía = en modo real no se factura crédito.
SIIGO_PAYMENT_CREDITO_ID=

# Validación de precios de la caja: horas hacia atrás en que un precio/IVA/SKU anterior sigue siendo válido
# (para ventas hechas sin conexión antes de un cambio de precio). Cualquier otra diferencia retiene la venta.
PRICE_HISTORY_HOURS=72
